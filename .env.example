# StockXpress Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real credentials to version control

#=================================================================
# Common Configuration
#=================================================================
SPRING_PROFILES_ACTIVE=docker
TZ=UTC

#=================================================================
# Discovery Server (Eureka)
#=================================================================
EUREKA_PORT=8761
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change_this_password
EUREKA_HOSTNAME=discovery-server

#=================================================================
# API Gateway
#=================================================================
GATEWAY_PORT=8080

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/spring-boot-microservices-realm
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/spring-boot-microservices-realm/protocol/openid-connect/certs

#=================================================================
# Product Service
#=================================================================
PRODUCT_SERVICE_PORT=8081

# MongoDB Configuration
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=product-service
MONGO_USERNAME=productuser
MONGO_PASSWORD=change_mongo_password

#=================================================================
# Inventory Service
#=================================================================
INVENTORY_SERVICE_PORT=8082

# MySQL Configuration
INVENTORY_DB_HOST=mysql-inventory
INVENTORY_DB_PORT=3306
INVENTORY_DB_NAME=inventory_service
INVENTORY_DB_USERNAME=inventoryuser
INVENTORY_DB_PASSWORD=change_inventory_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_redis_password

#=================================================================
# Order Service
#=================================================================
ORDER_SERVICE_PORT=8083

# MySQL Configuration
ORDER_DB_HOST=mysql-order
ORDER_DB_PORT=3306
ORDER_DB_NAME=order_service
ORDER_DB_USERNAME=orderuser
ORDER_DB_PASSWORD=change_order_password

#=================================================================
# Notification Service
#=================================================================
NOTIFICATION_SERVICE_PORT=8084

# H2 Database (for ProcessedEvent tracking)
H2_CONSOLE_ENABLED=false

#=================================================================
# Kafka Configuration
#=================================================================
KAFKA_BOOTSTRAP_SERVERS=broker:29092
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_REPLICATION_FACTOR=1

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka Broker
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

#=================================================================
# Zipkin (Distributed Tracing)
#=================================================================
ZIPKIN_HOST=zipkin
ZIPKIN_PORT=9411
ZIPKIN_BASE_URL=http://zipkin:9411
ZIPKIN_ENABLED=true
SLEUTH_SAMPLER_PROBABILITY=1.0

#=================================================================
# Prometheus (Metrics)
#=================================================================
PROMETHEUS_PORT=9090

#=================================================================
# Grafana (Dashboards)
#=================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_grafana_password

#=================================================================
# Keycloak (Authentication)
#=================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_DB_VENDOR=mysql
KEYCLOAK_DB_ADDR=keycloak-mysql
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_keycloak_db_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_keycloak_admin_password

#=================================================================
# MySQL for Keycloak
#=================================================================
KEYCLOAK_MYSQL_ROOT_PASSWORD=change_keycloak_mysql_root_password
KEYCLOAK_MYSQL_DATABASE=keycloak
KEYCLOAK_MYSQL_USER=keycloak
KEYCLOAK_MYSQL_PASSWORD=change_keycloak_mysql_password

#=================================================================
# Logging
#=================================================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_STOCKXPRESS=DEBUG
LOG_LEVEL_SPRING_SECURITY=DEBUG
LOG_LEVEL_SPRING_WEB=DEBUG

#=================================================================
# JVM Options
#=================================================================
JAVA_OPTS=-Xms256m -Xmx512m
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

#=================================================================
# Resource Limits (for docker-compose)
#=================================================================
# CPU limits (cores)
SERVICE_CPU_LIMIT=1.0
SERVICE_CPU_RESERVATION=0.5

# Memory limits
SERVICE_MEMORY_LIMIT=1024M
SERVICE_MEMORY_RESERVATION=512M

DB_MEMORY_LIMIT=512M
DB_MEMORY_RESERVATION=256M