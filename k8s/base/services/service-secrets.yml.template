---
# Eureka Server Credentials Secret Template
# NOTE: This is a TEMPLATE file. Replace base64 encoded values with actual credentials.
# To encode: echo -n 'your-value' | base64
# For production, use Sealed Secrets or External Secrets Operator

apiVersion: v1
kind: Secret
metadata:
  name: eureka-credentials
  labels:
    app: stockxpress
    component: security
type: Opaque
data:
  # Default credentials (base64 encoded)
  # username: eureka (ZXVyZWth)
  # password: password (cGFzc3dvcmQ=)
  username: ZXVyZWth
  password: cGFzc3dvcmQ=

---
# MongoDB Credentials Secret Template
# NOTE: Replace with actual MongoDB credentials
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-credentials
  labels:
    app: stockxpress
    component: security
type: Opaque
data:
  # Example credentials (replace with actual values)
  # username: admin (YWRtaW4=)
  # password: mongopass (bW9uZ29wYXNz)
  username: YWRtaW4=
  password: bW9uZ29wYXNz

---
# Keycloak Admin Credentials Secret Template
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-credentials
  labels:
    app: stockxpress
    component: security
type: Opaque
data:
  # Example credentials (replace with actual values)
  # admin-username: admin (YWRtaW4=)
  # admin-password: admin (YWRtaW4=)
  admin-username: YWRtaW4=
  admin-password: YWRtaW4=