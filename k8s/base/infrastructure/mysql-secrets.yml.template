# MySQL Secrets Template
# DO NOT commit actual secrets to version control!
#
# This is a TEMPLATE file. To use it:
# 1. Copy this file: cp mysql-secrets.yml.template mysql-secrets.yml
# 2. Replace placeholder values with actual secrets
# 3. Apply to cluster: kubectl apply -f mysql-secrets.yml
# 4. Ensure mysql-secrets.yml is in .gitignore
#
# Alternative: Use external secret management:
# - Kubernetes External Secrets Operator with AWS Secrets Manager
# - HashiCorp Vault
# - Sealed Secrets
# - Cloud provider secret managers (GCP Secret Manager, Azure Key Vault)
---
apiVersion: v1
kind: Secret
metadata:
  name: mysql-order-secret
  namespace: stockxpress
  labels:
    app: mysql-order
    component: database
type: Opaque
data:
  # REPLACE these base64-encoded values before deployment!
  # Generate strong passwords and encode: echo -n 'your-password' | base64
  root-password: REPLACE_WITH_BASE64_ENCODED_ROOT_PASSWORD
  username: REPLACE_WITH_BASE64_ENCODED_USERNAME
  password: REPLACE_WITH_BASE64_ENCODED_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: mysql-inventory-secret
  namespace: stockxpress
  labels:
    app: mysql-inventory
    component: database
type: Opaque
data:
  # REPLACE these base64-encoded values before deployment!
  # Generate strong passwords and encode: echo -n 'your-password' | base64
  root-password: REPLACE_WITH_BASE64_ENCODED_ROOT_PASSWORD
  username: REPLACE_WITH_BASE64_ENCODED_USERNAME
  password: REPLACE_WITH_BASE64_ENCODED_PASSWORD