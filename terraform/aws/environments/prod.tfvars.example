# StockXpress Production Environment Configuration
# Copy this file to prod.tfvars and update with your actual values
# NEVER commit actual .tfvars files to version control

# Project Configuration
project_name = "stockxpress"
environment  = "production"
owner        = "platform-engineering"
cost_center  = "production-ops"

# AWS Configuration
aws_region = "us-east-1"

# Network Configuration
vpc_cidr             = "10.1.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
private_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24", "10.1.13.0/24"]

# EKS Configuration
eks_cluster_version = "1.28"
eks_node_groups = {
  general = {
    desired_size = 6
    min_size     = 3
    max_size     = 12
    instance_types = ["t3.xlarge"]
  }
  spot = {
    desired_size = 3
    min_size     = 0
    max_size     = 10
    instance_types = ["t3.xlarge"]
    capacity_type = "SPOT"
  }
}

# RDS Configuration (Multi-AZ for production)
rds_instance_class    = "db.r6g.xlarge"
rds_allocated_storage = 100
mysql_engine_version  = "8.0"

# DocumentDB Configuration (3-node cluster for HA)
documentdb_instance_class = "db.r6g.large"

# ElastiCache Configuration (Multi-AZ cluster)
redis_node_type      = "cache.r6g.large"
redis_engine_version = "7.0"

# MSK (Kafka) Configuration
kafka_version             = "3.5.1"
kafka_broker_instance_type = "kafka.m5.large"

# SECURITY: Database Passwords and Auth Tokens
# CRITICAL: DO NOT hardcode any passwords or tokens in this file!
# All sensitive values MUST be managed externally via AWS Secrets Manager.
#
# Required secrets for production:
# 1. RDS Order Service Password:
#    aws secretsmanager create-secret --name "stockxpress/production/rds-order-password" \
#      --secret-string "$(openssl rand -base64 32)" --region us-east-1
#
# 2. RDS Inventory Service Password:
#    aws secretsmanager create-secret --name "stockxpress/production/rds-inventory-password" \
#      --secret-string "$(openssl rand -base64 32)" --region us-east-1
#
# 3. DocumentDB Password:
#    aws secretsmanager create-secret --name "stockxpress/production/documentdb-password" \
#      --secret-string "$(openssl rand -base64 32)" --region us-east-1
#
# 4. Redis Auth Token:
#    aws secretsmanager create-secret --name "stockxpress/production/redis-auth-token" \
#      --secret-string "$(openssl rand -base64 32)" --region us-east-1
#
# 5. JWT Signing Key:
#    aws secretsmanager create-secret --name "stockxpress/production/jwt-signing-key" \
#      --secret-string "$(openssl rand -base64 64)" --region us-east-1
#
# Then reference in main.tf using data sources:
#   data "aws_secretsmanager_secret_version" "rds_order_password" {
#     secret_id = "stockxpress/production/rds-order-password"
#   }
#
# Rotation Policy:
# - Database passwords: Rotate every 90 days
# - Redis auth tokens: Rotate every 90 days
# - JWT signing keys: Rotate every 180 days with overlap period
#
# Backup and Recovery:
# - All secrets are backed up to secondary region (us-west-2)
# - Secrets are tagged with environment=production for cost tracking
# - Deletion protection enabled on all production secrets
